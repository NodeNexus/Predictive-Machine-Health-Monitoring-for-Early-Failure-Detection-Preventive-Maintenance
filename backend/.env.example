# Copy to backend/.env for local overrides. Every variable is optional -
# all of these already have working defaults in app/core/config.py.
# All settings use the IDEALAB_ prefix (see Settings.model_config).

# Reported by GET /api/health; purely informational.
IDEALAB_ENVIRONMENT=development

# Comma-separated list of allowed frontend origins for CORS. Plain text
# (not JSON) so it can be pasted directly into Render's env var UI.
# Always include your local dev origin plus the deployed frontend's origin.
IDEALAB_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Optional path overrides -------------------------------------------
# All default to real paths under the repository root, computed from this
# file's own location (Path(__file__).resolve()) - never hardcoded and
# never OS-specific, so they work unchanged on Linux/Render. Override only
# if you store these assets somewhere else (e.g. a mounted persistent
# volume on a paid Render instance).
#
# IDEALAB_VIDEO_DIR=/var/data/idealab/VIDEO
# IDEALAB_DATASET_DIR=/var/data/idealab/DATASET
# IDEALAB_MODELS_DIR=/var/data/idealab/models
# IDEALAB_DB_PATH=/var/data/idealab/idealab.db
